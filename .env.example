# Optional locally; Render sets PORT automatically in production.
PORT=4000

# Optional PostgreSQL persistence (use a pooled connection for app requests).
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Optional India-wide fallback search providers. Google Places remains the primary live POI/search provider.
NOMINATIM_URL=https://nominatim.openstreetmap.org
OVERPASS_API_URL=https://overpass.private.coffee/api/interpreter
# Optional additional Overpass mirrors, comma-separated. The app also has built-in public failover endpoints.
OVERPASS_API_URLS=https://overpass-api.de/api/interpreter,https://maps.mail.ru/osm/tools/overpass/api/interpreter
PHOTON_URL=https://photon.komoot.io/api/
# Photon fallback results are filtered to India; no fixed Bengaluru bias is applied.
# Set true only when you intentionally want to use the configured Overpass endpoint(s) alone.
OVERPASS_DISABLE_PUBLIC_FALLBACKS=false

APP_URL=http://localhost:4000
CONTACT_EMAIL=your-contact-email@your-domain.com


# Google Maps JavaScript API browser key. Restrict HTTP referrers and enable only
# Maps JavaScript API, Places API (New), and Routes API in Google Cloud.
# Browser key used by Maps JavaScript API, Places API (New) and Routes API.
GOOGLE_MAPS_API_KEY=
# Use your own Google Cloud map ID for production Advanced Markers and styling.
GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID
